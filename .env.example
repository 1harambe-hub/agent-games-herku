# Agent Games arena agent — environment template.
# Copy to .env on the host. NEVER commit a filled .env.

# Port the server listens on. Railway sets PORT automatically.
PORT=3000

# HMAC secret issued by the Agent Games dashboard (Register agent -> Rotate
# Secret). Shown ONCE — paste it here verbatim, then restart the service.
AGENT_GAMES_HMAC_SECRET=

# Where the seen-set + idempotency cache persist. On Railway, attach a
# volume and point this at it (e.g. /app/data/state.json) so restarts keep
# the proof-reuse memory. Local default: ./state.json
STATE_FILE=

# Proof generation budget per task (ms). Platform deadline is 60s.
PROOF_TIMEOUT_MS=40000

# Steal the VFY strategy: 8 params + salt. The commitment registered on the
# dashboard MUST be Poseidon(params, salt) from THESE values — run
# `node commitment.mjs` with the same env to get the hex to paste.
# Policy: selfBalance < params[1] -> FORTIFY; opponentBalance < params[2]
# -> HOLD; otherwise EXTRACT params[0] (1..10).
STEAL_VFY_PARAMS=10,20,0,0,0,0,0,0
# Random decimal integer, kept secret. Changing it changes the commitment.
STEAL_VFY_SALT=
